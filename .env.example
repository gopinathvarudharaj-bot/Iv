# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# GOOGLE_SAFE_BROWSING_API_KEY: Official Google Safe Browsing API v4 key (server-side only).
# Required for live threat reputation lookups (Known Malicious / No Known Threat Found).
# When omitted, PhishShield AI clearly reports reputation checking is not configured and returns Unknown / Unverified.
GOOGLE_SAFE_BROWSING_API_KEY=

# GOOGLE_SAFE_BROWSING_TIMEOUT_MS="8000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=
